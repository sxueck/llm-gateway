{
  "name": "llm-gateway",
  "version": "0.2.4",
  "private": true,
  "description": "轻量级 LLM 网关管理系统",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "dev": "npm run dev --workspaces --if-present",
    "dev:backend": "npm run dev -w @llm-gateway/backend",
    "dev:web": "npm run dev -w @llm-gateway/web",
    "dev:all": "node scripts/dev-all.js",
    "build": "npm run build --workspaces --if-present",
    "build:backend": "npm run build -w @llm-gateway/backend",
    "build:web": "npm run build -w @llm-gateway/web",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "clean": "npm run clean --workspaces --if-present",
    "lint": "npm run lint --workspaces --if-present",
    "start": "npm run start -w @llm-gateway/backend",
    "fix:db": "node scripts/fix-database.js",
    "prepare": "bash scripts/install-hooks.sh"
  },
  "keywords": [
    "llm",
    "gateway",
    "web-ui",
    "openai",
    "api-gateway",
    "load-balancing",
    "failover",
    "monorepo"
  ],
  "author": "SXueckShen <sxueck@outlook.com>",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/sxueck/llm-gateway.git"
  },
  "bugs": {
    "url": "https://github.com/sxueck/llm-gateway/issues"
  },
  "homepage": "https://github.com/sxueck/llm-gateway#readme",
  "devDependencies": {
    "@types/ws": "^8.18.1",
    "tsx": "^4.21.0",
    "typescript": "^5.7.2"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "dependencies": {
    "@fastify/websocket": "^11.0.0",
    "ws": "^8.21.0"
  }
}
