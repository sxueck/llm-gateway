PORT=3000
NODE_ENV=development
LOG_LEVEL=info
JWT_SECRET=your-secret-key-change-this-in-production
API_REQUEST_LOG_RETENTION_DAYS=14

# MySQL 数据库配置
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=your-mysql-password
MYSQL_DATABASE=llm_gateway

# LLM Gateway 公网访问地址
# 如果部署在公网服务器上，请设置为实际的公网地址
# 例如: http://your-domain.com 或 http://your-ip:3000
# 此配置也可以在 Web UI 的系统设置页面中动态修改
PUBLIC_URL=http://localhost:3000

# 本地意图分类器开关 (可选)
# 设为 off 时，启动时不加载本地 ONNX 意图分类器（约 615MB artifacts 不会占用内存）。
# 专家路由自动回退到 LLM 二次分类 / fallback，/v1/intent/classify 返回 503 classifier_disabled。
# 不使用专家路由和意图分类 API 的部署建议开启，可显著降低内存占用。
# 可选值: off / disabled / 0 / false（不设置或任意其他值 = 默认开启）
# LOCAL_INTENT_CLASSIFIER=off

# 消息压缩配置 (可选)
# 定义在压缩历史消息时要保留的最新消息数量
# 默认值为 2，表示保留最后两条消息不进行压缩
# 如果设置为 5，则保留最后五条消息
KEEP_RECENT_MESSAGES=5

# S3 兼容存储备份配置 (可选)
# 支持 AWS S3、MinIO、Cloudflare R2、阿里云 OSS 等所有 S3 兼容存储
S3_ENDPOINT=http://localhost:9000
S3_BUCKET_NAME=llm-gateway-backups
S3_REGION=us-east-1
S3_ACCESS_KEY_ID=your_access_key
S3_SECRET_ACCESS_KEY=your_secret_key
S3_FORCE_PATH_STYLE=true

# 常见服务配置示例：
# MinIO: S3_ENDPOINT=http://localhost:9000, S3_FORCE_PATH_STYLE=true
# Cloudflare R2: S3_ENDPOINT=https://<account-id>.r2.cloudflarestorage.com, S3_FORCE_PATH_STYLE=false
# 阿里云 OSS: S3_ENDPOINT=https://oss-cn-hangzhou.aliyuncs.com, S3_FORCE_PATH_STYLE=false
# AWS S3: 留空 S3_ENDPOINT, S3_FORCE_PATH_STYLE=false

# 备份调度配置 (可选)
# 定时备份的 Cron 表达式，默认每天凌晨 2 点执行
BACKUP_SCHEDULE_CRON=0 2 * * *
# 备份保留天数，默认 30 天
BACKUP_RETENTION_DAYS=30
# 最大备份数量，默认 50 个
BACKUP_MAX_COUNT=50
# 是否包含日志数据，默认 false
BACKUP_INCLUDE_LOGS=false
# 备份临时目录，默认为项目目录下的 temp/backups
# BACKUP_TEMP_DIR=/path/to/temp/backups


# PII 防护性能调优 (可选)
# 单个文本字段最大扫描长度（字符），超过则跳过检测以保护 CPU 与编码场景的模型质量
# （宁可漏检也不卡死/不破坏代码上下文），默认 50000
PII_MAX_FIELD_SCAN_LENGTH=50000
# 单个字段最多收集的匹配候选数，超过则停止（避免日志粘贴等场景的二次方开销），默认 2000
PII_MAX_MATCHES_PER_FIELD=2000
# 单次请求所有字段累计最大扫描字符数，超过则剩余字段不再脱敏，默认 500000
PII_MAX_TOTAL_SCAN_CHARS=500000
