# LLM Gateway Compose 部署环境变量（复制为 .env 后修改）

# 必改：JWT 密钥，生产环境必须为强随机字符串（至少 32 字符）。
# 该值也用于加密数据，迁移/恢复环境时必须保持一致。
JWT_SECRET=please-change-this-secret-key-to-a-random-string-at-least-32-chars

# MySQL
MYSQL_PASSWORD=your-mysql-password
MYSQL_DATABASE=llm_gateway

# Agent Search / craft-worker（默认启用，需完成部署文档中的准备步骤）
# 宿主机 docker 组 gid：getent group docker | cut -d: -f3
DOCKER_GID=999
# worker workspace 目录，须与下方路径一致并 chown 1001:1001（文档中有准备命令）
AGENT_WORKSPACE_DIR=/opt/llm-gateway/agent-workspaces
# worker 模型调用自动记账到创建 run 的虚拟密钥（该密钥需绑定插件所用模型），无需预置内部密钥
# 一般无需修改：
# AGENT_WORKER_IMAGE=ghcr.io/sxueck/llm-gateway/craft-worker:latest
# AGENT_WORKER_GATEWAY_URL=http://host.docker.internal:13030
