{
  "name": "@llm-gateway/backend",
  "version": "0.2.4",
  "private": true,
  "description": "LLM Gateway Backend Service",
  "type": "module",
  "main": "dist/index.js",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "esbuild src/index.ts --bundle --outfile=dist/index.js --platform=node --format=esm --minify --banner:js=\"import { createRequire } from 'node:module';const require = createRequire(import.meta.url);\" --external:@aws-sdk/client-s3 --external:@xenova/transformers --external:node-cron --external:onnxruntime-node --external:onnxruntime-web --external:onnxruntime-common --external:pino --external:pino-pretty --external:sharp --external:tiktoken",
    "start": "node dist/index.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc -p ../shared/tsconfig.json --emitDeclarationOnly && tsc --noEmit",
    "lint": "tsc -p ../shared/tsconfig.json --emitDeclarationOnly && tsc --noEmit --noUnusedLocals false --noUnusedParameters false --noImplicitReturns false",
    "clean": "rm -rf dist",
    "fix:db": "node scripts/fix-database.js"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.82.0",
    "@aws-sdk/client-s3": "^3.940.0",
    "@fastify/cors": "^11.1.0",
    "@fastify/jwt": "^10.0.0",
    "@fastify/static": "^8.0.2",
    "@google/generative-ai": "^0.24.1",
    "@llm-gateway/shared": "workspace:*",
    "@xenova/transformers": "^2.17.2",
    "chinese-workday": "^2.0.0",
    "date-holidays": "^3.30.2",
    "dotenv": "^17.2.3",
    "fastify": "^5.2.0",
    "ip2region": "^2.3.0",
    "jsonrepair": "^3.13.2",
    "mysql2": "^3.15.3",
    "nanoid": "^5.0.9",
    "node-cron": "^4.2.1",
    "openai": "^6.33.0",
    "pino": "^9.6.0",
    "pino-pretty": "^13.0.0",
    "sharp": "^0.33.5",
    "tar": "^7.5.2",
    "tiktoken": "^1.0.22",
    "https-proxy-agent": "^7.0.6",
    "undici": "^7.0.0",
    "uuid": "^13.0.0",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "@types/node-cron": "^3.0.11",
    "@types/tar": "^6.1.13",
    "esbuild": "^0.27.2",
    "typescript": "^5.7.2",
    "vitest": "^3.0.0"
  }
}
